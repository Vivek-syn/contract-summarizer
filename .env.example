# ============================================================================
# Contract IDP - every value below is optional; these are the defaults.
# ============================================================================

# --- app --------------------------------------------------------------------
APP_ENV=local
APP_PORT=8000
LOG_LEVEL=INFO
LOG_JSON_OUTPUT=false

# --- OCR --------------------------------------------------------------------
# azure | aws | none.  'none' disables OCR; nothing will run without a provider.
OCR_PROVIDER=azure
OCR_CACHE_ENABLED=true          # cache by document content hash - makes reruns free
OCR_MAX_CONCURRENCY=5

# Azure Document Intelligence.
# prebuilt-layout returns tables, selection marks and paragraph roles, so clause
# hierarchy survives. prebuilt-read is ~6x cheaper and flattens all of that.
OCR_AZURE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
OCR_AZURE_KEY=
OCR_AZURE_MODEL_ID=prebuilt-layout

# AWS Textract. Empty feature list falls back to DetectDocumentText.
OCR_AWS_REGION=ap-south-1
# OCR_AWS_ACCESS_KEY_ID=        # omit to use the instance role
# OCR_AWS_SECRET_ACCESS_KEY=

# --- database (validation rules live here, not in YAML) ---------------------
# SQLite by default so no server is needed. Both drivers must be async.
DB_URL=sqlite+aiosqlite:///./data/contract_idp.db
# DB_URL=postgresql+asyncpg://user:pass@localhost:5432/contract_idp
DB_AUTO_CREATE=true              # create tables at startup; set false and use alembic in prod
DB_ECHO=false

# --- storage ----------------------------------------------------------------
# local | azure | s3.  A run outlives its request, so the source PDF, the OCR
# output and each stage's result all have to be durable.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./data/storage

# STORAGE_AZURE_CONNECTION_STRING=
# STORAGE_AZURE_ACCOUNT_URL=    # with DefaultAzureCredential, instead of a key
# STORAGE_AZURE_CONTAINER=contract-idp

# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=ap-south-1
# STORAGE_S3_PREFIX=contract-idp/

# --- models -----------------------------------------------------------------
# LiteLLM-qualified: <provider>/<model>. Switching provider needs no code change.
LLM_MODEL=anthropic/claude-opus-5
LLM_FAST_MODEL=anthropic/claude-haiku-4-5    # type detection, a routing call
LLM_EFFORT=high                              # low|medium|high|xhigh|max
LLM_THINKING=true                            # Anthropic adaptive thinking
LLM_MAX_TOKENS=16000

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- pipeline ---------------------------------------------------------------
PIPELINE_DOCTYPE_CONFIG_DIR=./doctypes
PIPELINE_PLAYBOOK_SEED_DIR=./seeds/playbooks
PIPELINE_ENABLE_GROUNDING=true
PIPELINE_ENABLE_VALIDATION=true
PIPELINE_VALIDATION_CONCURRENCY=4            # rules checked in parallel
PIPELINE_MAX_UPLOAD_MB=50
PIPELINE_MAX_PAGES=300

# --- quota ------------------------------------------------------------------
QUOTA_ENABLED=false
QUOTA_MAX_TOKENS_PER_RUN=2000000
QUOTA_MAX_USD_PER_RUN=10.0
