# Set the key for whichever provider your model strings point at.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# All optional - these are the defaults.
# Model strings are LiteLLM-qualified: <provider>/<model>. Switching provider
# needs no code change; llm.py adapts the request params to whichever you name.
SUMMARIZER_MODEL=anthropic/claude-opus-5
SUMMARIZER_JUDGE_MODEL=anthropic/claude-opus-5
# e.g. SUMMARIZER_MODEL=openai/gpt-5
# The two may differ - running the judge on a different provider than the
# author is a cheap way to avoid one model grading its own homework.

SUMMARIZER_MAX_TOKENS=16000
# Anthropic: low|medium|high|xhigh|max. OpenAI: mapped to reasoning_effort
# (xhigh/max collapse to high), and dropped on non-reasoning models.
SUMMARIZER_EFFORT=high
# Anthropic adaptive thinking; ignored by other providers.
SUMMARIZER_THINKING=1
SUMMARIZER_JUDGE_THRESHOLD=0.75
SUMMARIZER_MAX_REPAIRS=2
